[MESSAGES CONTROL]
disable = missing-function-docstring,
        missing-module-docstring,
        missing-class-docstring,
        import-outside-toplevel,
        attribute-defined-outside-init,
        line-too-long,
        invalid-str-returned,
        no-member,
        unused-argument,
        import-error,
        not-callable,
        redefined-builtin,
        broad-exception-caught,
        missing-timeout,
        redefined-outer-name,
        fixme,
